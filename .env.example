# Copy outside the source checkout; scripts/dev.ps1 accepts -EnvFile.
# Replace placeholders locally. Never commit real credentials.
GROQ_API_KEY=
VOYAGE_API_KEY=
SESSION_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SECRET=replace-with-at-least-32-random-characters
BANK_WRITE_SECRET=replace-with-a-different-32-character-secret
POSTGRES_PASSWORD=replace-with-random-database-password
RABBIT_PASSWORD=replace-with-random-broker-password
LLM_MODEL=groq/openai/gpt-oss-120b
LLM_FALLBACK_MODEL=groq/qwen/qwen3.8-27b
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
